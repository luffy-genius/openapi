# Copy this file to .env. Keep all real credentials out of Git.
# Request inputs and parameters are reference constants in each capability script.

# DeepSeek
MEDIA_DEEPSEEK_API_KEY=
MEDIA_DEEPSEEK_BASE_URL=https://api.deepseek.com
MEDIA_DEEPSEEK_MODEL=deepseek-chat

# Aliyun Bailian
MEDIA_ALIYUN_API_KEY=
MEDIA_ALIYUN_WORKSPACE_ID=
MEDIA_ALIYUN_REGION=cn-beijing
MEDIA_ALIYUN_TEXT_MODEL=
MEDIA_ALIYUN_SPEECH_MODEL=qwen-audio-3.0-tts-flash
MEDIA_ALIYUN_SPEECH_VOICE=longanhuan_v3.6
MEDIA_ALIYUN_IMAGE_MODEL=
MEDIA_ALIYUN_VIDEO_MODEL=
MEDIA_ALIYUN_DIGITAL_HUMAN_MODEL=

# Volcengine Ark, speech, and visual API credentials are independent.
MEDIA_VOLCENGINE_ARK_API_KEY=
MEDIA_VOLCENGINE_ACCESS_KEY=
MEDIA_VOLCENGINE_SECRET_KEY=
MEDIA_VOLCENGINE_TEXT_MODEL=
MEDIA_VOLCENGINE_IMAGE_MODEL=
MEDIA_VOLCENGINE_VIDEO_MODEL=
MEDIA_VOLCENGINE_DIGITAL_HUMAN_MODEL=
MEDIA_VOLCENGINE_SPEECH_APP_ID=
MEDIA_VOLCENGINE_SPEECH_ACCESS_TOKEN=
MEDIA_VOLCENGINE_SPEECH_BASE_URL=https://openspeech.bytedance.com/api/v1/tts
MEDIA_VOLCENGINE_SPEECH_MODEL=volcano_tts
MEDIA_VOLCENGINE_SPEECH_VOICE=

# HiFly
MEDIA_HIFLY_TOKEN=
MEDIA_HIFLY_SPEECH_MODEL=hifly-v2
MEDIA_HIFLY_SPEECH_VOICE=
MEDIA_HIFLY_AVATAR_ID=
MEDIA_HIFLY_AVATAR_CLONE_MODEL=2
MEDIA_HIFLY_DIGITAL_HUMAN_MODEL=

# Polling, output, workflow, and task recovery
MEDIA_TASK_TIMEOUT=1800
MEDIA_POLL_INTERVAL=5
MEDIA_OUTPUT_DIR=examples/media_generation/output
MEDIA_WORKFLOW_SPEECH_PROVIDER=aliyun
MEDIA_TASK_REF=
